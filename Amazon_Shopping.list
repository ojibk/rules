# NAME: Amazon_Shopping_Rules
# DESCRIPTION: 全球零售站点 + 核心静态图片资产 + 广告与前端组件库 + 卖家及物流体系规则集（不含 AWS 基础云）
# TOTAL_ITEMS: 56

payload:
  # ══════════════════════════════════════════════════════════════════════
  # 1. 北美与拉美核心市场 (North & Latin America)
  # ══════════════════════════════════════════════════════════════════════
  - '+.amazon.com'            # 美国 / 全球主站
  - '+.amazon.ca'             # 加拿大
  - '+.amazon.com.mx'         # 墨西哥
  - '+.amazon.com.br'         # 巴西
  - '+.amazon.co'             # 哥伦比亚官方站点
  - '+.amazon.cl'             # 智利官方站点

  # ══════════════════════════════════════════════════════════════════════
  # 2. 欧洲全域站点 (Europe)
  # ══════════════════════════════════════════════════════════════════════
  - '+.amazon.co.uk'          # 英国
  - '+.amazon.de'             # 德国
  - '+.amazon.fr'             # 法国
  - '+.amazon.it'             # 意大利
  - '+.amazon.es'             # 西班牙
  - '+.amazon.nl'             # 荷兰
  - '+.amazon.pl'             # 波兰
  - '+.amazon.se'             # 瑞典
  - '+.amazon.com.be'         # 比利时
  - '+.amazon.at'             # 奥地利官方站点
  - '+.amazon.lu'             # 卢森堡官方站点

  # ══════════════════════════════════════════════════════════════════════
  # 3. 亚太与大洋洲核心站点 (Asia-Pacific & Oceania)
  # ══════════════════════════════════════════════════════════════════════
  - '+.amazon.co.jp'          # 日本前台
  - '+.amazon.jp'             # 日本快捷域名
  - '+.amazon.sg'             # 新加坡
  - '+.amazon.com.au'         # 澳大利亚
  - '+.amazon.in'             # 印度
  - '+.amazon.cn'             # 中国（海外购/电子书基础设施）
  - '+.z.cn'                  # 中国亚马逊快捷秒开域名

  # ══════════════════════════════════════════════════════════════════════
  # 4. 中东与非洲新兴市场 (Middle East & Africa)
  # ══════════════════════════════════════════════════════════════════════
  - '+.amazon.ae'             # 阿联酋
  - '+.amazon.sa'             # 沙特阿拉伯
  - '+.amazon.eg'             # 埃及
  - '+.amazon.com.tr'         # 土耳其
  - '+.amazon.com.za'         # 南非

  # ══════════════════════════════════════════════════════════════════════
  # 5. 国际化非标准域名与本地转码后缀 (IDN / Specific)
  # ══════════════════════════════════════════════════════════════════════
  - '+.xn--jlq480n2rg'        # "亚马逊" 中文字符串转码后缀
  - '+.xn--cckwcxetd'        # "アマゾン" 日语片假名字符串转码后缀

  # ══════════════════════════════════════════════════════════════════════
  # 6. 全球统一：高清商品图片、Listing 详情、视频与前端核心资产（核心流量大户）
  # ══════════════════════════════════════════════════════════════════════
  - '+.images-amazon.com'     # 基础静态资源、广告位、类目横幅图
  - '+.ssl-images-amazon.com' # 全球主图、A+变体图、防爬Captcha验证码
  - '+.media-amazon.com'      # 主图视频、买家评论视频、3D渲染动态图
  - '+.a2z.com'               # 网页基础样式表（CSS）、交互脚本（JS）、全站排版框架
  - '+.amzn.com'              # 官方全局辅助短域名
  - '+.amzn.to'               # 官方商品一键分享、买家短链接
  - '+.amazon-shoppable-videos.com' # Listing 详情页买家秀与主图视频分发 CDN

  # ══════════════════════════════════════════════════════════════════════
  # 7. 垂直购物核心补充资产
  # ══════════════════════════════════════════════════════════════════════
  - '+.shopbop.com'           # 亚马逊旗下女性时尚购物站（统一前端资产）
  - '+.eastdane.com'          # 亚马逊旗下男性时尚购物站
  - '+.6pm.com'               # 亚马逊旗下大型服装鞋帽折扣网
  - '+.zappos.com'            # 亚马逊旗下全美最大鞋类电商（核心流量与分流同源）
  - '+.zappos.io'             # Zappos 静态缓存与边缘分发网络
  - '+.javari.jp'             # 亚马逊日本垂直鞋包资产遗留域名
  - '+.audible.com'           # 亚马逊旗下有声书核心全域

  # ══════════════════════════════════════════════════════════════════════
  # 8. 智能硬件、配对网关与买家交互生态、结账网关
  # ══════════════════════════════════════════════════════════════════════
  - '+.kindle.com'            # Kindle 电子书设备同步与内容商店
  - '+.kindle.co.uk'          # Kindle 英国内容分发
  - '+.kindle.co.jp'          # Kindle 日本内容分发
  - '+.amazon-devicesupport.com' # Echo 智能音箱、FireTV 等设备的全局分流与系统OTA固件
  - '+.amazonpay.com'         # 亚马逊支付全球门户
  - '+.amazonpay.in'          # 印度站支付门户

  # ══════════════════════════════════════════════════════════════════════
  # 9. 卖家后台、广告系统、API 数据同步与官方物流追踪生态
  # ══════════════════════════════════════════════════════════════════════
  - '+.amazonservices.com'    # 卖家 API 数据同步接口
  - '+.amazon.dev'            # 亚马逊开发者与广告生态级联网关（包含 api.stores... 资产）
  - '+.amazon-adsystem.com'   # 全站 Listing 推荐位与赞助商组件加载源
  - '+.amazonadvertising.com' # 亚马逊全球广告主控制台门户
  - '+.amazon.advertising'    # 官方广告业务专属 TLD 网关
  - '+.assoc-amazon.com'      # 亚马逊联盟/关联促销流量追踪组件
  - '+.amazonlogistics.com'   # 亚马逊自建物流（AMZL）订单状态与轨迹追踪
  - '+.amazon.delivery'       # 末端转运与 Flex 配送生态专属域名